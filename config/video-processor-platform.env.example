# Configuración privada de la plataforma web.
# El selector administrativo decide cuál ruta se usa; conservar ambos juegos permite alternar sin editar código.
VIDEO_LOCAL_PROCESSOR_URL=https://REEMPLAZAR-EQUIPO-PROPIO.example
VIDEO_LOCAL_PROCESSOR_SHARED_SECRET=REEMPLAZAR_SECRETO_EQUIPO_PROPIO

VIDEO_PERSISTENT_PROCESSOR_URL=https://REEMPLAZAR-SERVICIO-PERSISTENTE.example
VIDEO_PERSISTENT_PROCESSOR_SHARED_SECRET=REEMPLAZAR_SECRETO_SERVICIO_PERSISTENTE

# Compatibilidad con una instalación anterior de ruta única. No se usa cuando las variables separadas están completas.
VIDEO_PROCESSOR_URL=https://REEMPLAZAR-PROCESADOR-LEGADO.example
VIDEO_PROCESSOR_SHARED_SECRET=REEMPLAZAR_SECRETO_LEGADO
