# Selecciona una sola ruta por entorno: local-worker o persistent-worker.
VIDEO_PROCESSOR_MODE=local-worker

# Puerto del servicio de procesamiento. No es el puerto de la plataforma web.
VIDEO_PROCESSOR_PORT=REEMPLAZAR_PUERTO

# Este trabajador usa una sola ruta y valida este secreto contra la plataforma.
# La URL HTTPS se configura en la plataforma, no es necesaria para arrancar este proceso.
VIDEO_PROCESSOR_SHARED_SECRET=REEMPLAZAR_CON_UN_SECRETO_LARGO

# El trabajador necesita acceso a la misma base de datos y a las credenciales del almacenamiento gestionado.
DATABASE_URL=REEMPLAZAR_DATABASE_URL
BUILT_IN_FORGE_API_URL=REEMPLAZAR_FORGE_API_URL
BUILT_IN_FORGE_API_KEY=REEMPLAZAR_FORGE_API_KEY
