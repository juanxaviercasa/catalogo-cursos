# ==========================================
# CATÁLOGO DE CURSOS - CONFIGURACIÓN DEL ENTORNO
# ==========================================

# Puerto de la aplicación web (por defecto 3000)
PORT=3000

# Secreto para firma de cookies y sesiones JWT (mínimo 32 caracteres)
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS

# Identificador de la aplicación
VITE_APP_ID=catalogo-cursos

# URL pública del portal OAuth usado actualmente por la aplicación (valor de configuración, no secreto)
VITE_OAUTH_PORTAL_URL=CONFIGURAR_SEGUN_EL_PROVEEDOR_OAUTH

# URL de la API OAuth correspondiente; guardar también en el entorno del backend
OAUTH_SERVER_URL=CONFIGURAR_SEGUN_EL_PROVEEDOR_OAUTH

# Usuario propietario con rol de Administrador
OWNER_OPEN_ID=REEMPLAZAR_POR_EL_OPEN_ID_REAL_DEL_PROPIETARIO

# ==========================================
# 1. BASE DE DATOS (PostgreSQL de Supabase)
# ==========================================
# Usa la URI PostgreSQL de tu proyecto Supabase; guárdala como secreto del host, nunca en Git.
DATABASE_URL=postgresql://postgres:CONTRASENA@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# ==========================================
# 2. ALMACENAMIENTO DE ARCHIVOS (Storage)
# ==========================================
# Driver a utilizar: "local" (predeterminado) o "s3" (para Cloudflare R2 / AWS S3 / MinIO)
STORAGE_DRIVER=local

# Si STORAGE_DRIVER=local: Directorio donde se guardan vídeos, pistas de audio, subtítulos y PDFs
STORAGE_DIR=storage_data

# Si STORAGE_DRIVER=s3 (por ejemplo para Cloudflare R2):
# S3_BUCKET=mi-bucket-cursos
# S3_ENDPOINT=https://<id-cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=tu-access-key-id
# S3_SECRET_ACCESS_KEY=tu-secret-access-key
# S3_PUBLIC_URL=https://cdn.tudominio.com

# ==========================================
# 3. DOBLAJE Y TRADUCCIÓN (Inglés -> Español)
# ==========================================
# Modo de doblaje: "local" (Whisper + Piper TTS) o "api" (OpenAI / Groq / ElevenLabs)
DUBBING_PROVIDER_MODE=local

# Si usas Piper TTS local:
# PIPER_BIN=C:\herramientas\piper\piper.exe
# PIPER_MODEL=C:\herramientas\piper\es_ES-davefx-medium.onnx

# Si usas APIs de IA (opcional):
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# ELEVENLABS_API_KEY=...
